    {
      "parameters": {
        "jsCode": "let results = [];\n\nfor (const item of $input.all()) {\n  let rawText = item.json.output?.[0]?.content?.[0]?.text || \"\";\n\n  let parsed = {};\n  try {\n    // First attempt: direct parse\n    parsed = JSON.parse(rawText);\n  } catch (e) {\n    // Fallback: try to clean up the text into valid JSON\n    let cleaned = rawText\n      // Remove leading/trailing junk\n      .trim()\n      // Replace raw newlines inside values with escaped \\n\n      .replace(/:\\s*\"([^\"]*?)\\n([^\"]*?)\"/g, (m, p1, p2) => {\n        return `: \"${p1}\\\\n${p2}\"`;\n      })\n      // Remove stray backticks or code fences\n      .replace(/```[a-z]*\\n?/g, \"\")\n      .replace(/```/g, \"\");\n\n    try {\n      parsed = JSON.parse(cleaned);\n    } catch (err) {\n      // Last fallback: regex key/value extraction\n      const matches = [...cleaned.matchAll(/\"([^\"]+)\"\\s*:\\s*\"([^\"]*)\"/g)];\n      for (const m of matches) {\n        parsed[m[1]] = m[2].replace(/\\\\n/g, \"\\n\").trim();\n      }\n    }\n  }\n\n  results.push({ json: parsed });\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1312,
        272
      ],
      "id": "0ee151aa-9172-49ca-8905-8d94e13777c6",
      "name": "Normalize Output"
    },
    {
      "parameters": {
        "jsCode": "function fillPrompt(template, data) {\n  return template.replace(/\\{([^}]+)\\}/g, (match, key) => {\n    // Handle nested keys like data.c_name\n    const parts = key.split('.');\n    let value = data;\n    for (const part of parts) {\n      if (value && part in value) {\n        value = value[part];\n      } else {\n        return match; // leave placeholder if not found\n      }\n    }\n    return Array.isArray(value) ? value.join(\", \") : value;\n  });\n}\n// Loop over input items and add a new field called 'myNewField' to the JSON of each one\nfor (const item of $input.all()) {\n  item.json.usermessage = fillPrompt(item.json.c_user_prompt, item.json.data);\n}\n\nreturn $input.all();"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
