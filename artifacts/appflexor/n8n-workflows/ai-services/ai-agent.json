        "query": "select a.c_system_prompt, t.c_user_prompt, t.c_sql_query,\n  t.c_vector_query\n  from app_fd_ai_agent a \njoin app_fd_ai_agent_task t on t.c_agent::uuid=a.id\nwhere a.c_agent_key=$1 and t.c_task_key=$2 limit 1",
        "options": {
