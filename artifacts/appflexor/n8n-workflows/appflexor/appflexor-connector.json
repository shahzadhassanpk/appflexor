    {
      "parameters": {
        "jsCode": "let data = [];\n// Loop over input items and add a new field called 'myNewField' to the JSON of each one\nfor (const item of $input.all()) {\n  let raw = item.json.variables[\"appflexor.worker.meta\"];\n  try{\n    let parsed = JSON.parse(raw.value);\n    let connectorTopic = parsed[\"connector.topic\"];\n    let kafkaTopic = `${item.json.tenantId}-${connectorTopic}`;\n    let task = {kafkaTopic, payload:item.json, isValid:true};\n    data.push(task);\n  }catch(e){\n    data.push({raw:raw.value, isValid:false});\n  }  \n}\n\nreturn data;"
      },
