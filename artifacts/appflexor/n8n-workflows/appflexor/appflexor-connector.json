        "query": "WITH inserted AS (\n  INSERT INTO external_task_dispatch (\n    tenant_id, external_task_id, status, fetched_at\n  )\n  VALUES ($1, $2, 'CLAIMED', NOW())\n  ON CONFLICT (tenant_id, external_task_id) DO NOTHING\n  RETURNING 1\n)\nSELECT\n  $1 AS tenant_id,\n  $2 AS external_task_id,\n  COALESCE(MAX(1), 0) = 1 AS is_new\nFROM inserted;",
