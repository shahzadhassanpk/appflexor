  <bpmn:process id="leave_application_process" name="Leave Application" isExecutable="true" camunda:historyTimeToLive="10">
    <bpmn:laneSet id="LaneSet_11d978f">
      <bpmn:lane id="Lane_02yhyki" name="Manager">
        <bpmn:flowNodeRef>Event_1anrj1x</bpmn:flowNodeRef>
