    <bpmn:sequenceFlow id="Flow_0jrihz4" sourceRef="Event_1og8wc4" targetRef="Event_0uo21qg" />
    <bpmn:sequenceFlow id="Flow_1v4j5ak" name="Approve / Reject" sourceRef="Gateway_00q9831" targetRef="Event_1anrj1x">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${status == 'APPROVED' || status == 'REJECTED'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_17zeqae" name="Status" sourceRef="accept_leave" targetRef="Gateway_00q9831" />
    <bpmn:sequenceFlow id="Flow_1vxjazp" name="Status = Revise" sourceRef="Gateway_00q9831" targetRef="revise_leave">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${status=='REVISE'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0auv9u6" sourceRef="Event_0uo21qg" targetRef="accept_leave" />
    <bpmn:sequenceFlow id="Flow_1lotj94" sourceRef="revise_leave" targetRef="accept_leave" />
