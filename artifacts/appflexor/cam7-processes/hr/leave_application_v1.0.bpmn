      <bpmn:outgoing>Flow_1vxjazp</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:userTask id="accept_leave" name="Approve Leave" camunda:formKey="leave_approval" camunda:candidateGroups="ADMIN">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:outputParameter name="status">${action}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1lotj94</bpmn:incoming>
      <bpmn:incoming>Flow_0jrihz4</bpmn:incoming>
      <bpmn:outgoing>Flow_17zeqae</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="revise_leave" name="Revise Leave" camunda:formKey="leave_application" camunda:candidateGroups="ADMIN">
      <bpmn:incoming>Flow_1vxjazp</bpmn:incoming>
      <bpmn:outgoing>Flow_1lotj94</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_0jrihz4" sourceRef="Event_1og8wc4" targetRef="accept_leave" />
    <bpmn:sequenceFlow id="Flow_1v4j5ak" name="Approve / Reject" sourceRef="Gateway_00q9831" targetRef="Event_1anrj1x">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${status == 'APPROVED' || status == 'REJECTED'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_17zeqae" name="Status" sourceRef="accept_leave" targetRef="Gateway_00q9831" />
    <bpmn:sequenceFlow id="Flow_1vxjazp" name="Status = Revise" sourceRef="Gateway_00q9831" targetRef="revise_leave">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${status=='REVISE'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1lotj94" sourceRef="revise_leave" targetRef="accept_leave" />
  </bpmn:process>
