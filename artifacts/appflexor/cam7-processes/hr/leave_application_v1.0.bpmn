    </bpmn:inclusiveGateway>
    <bpmn:userTask id="accept_leave" name="Approve Leave" camunda:formKey="leave_approval" camunda:candidateGroups="ADMIN">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:outputParameter name="status">${action}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0auv9u6</bpmn:incoming>
      <bpmn:incoming>Flow_1lotj94</bpmn:incoming>
      <bpmn:outgoing>Flow_17zeqae</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="revise_leave" name="Revise Leave" camunda:formKey="leave_application" camunda:candidateGroups="ADMIN">
