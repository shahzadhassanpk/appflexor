# Appflexor Connector — environment variables
# Copy this file to .env for local development.
# In Replit, set these as secrets / env vars via the Secrets panel.

LOGIN=admin
PASSWORD=your-password-here
AUTH_URL=https://your-instance.step2agility.com/app/service?service.key=login
BPM_URL=https://your-instance.step2agility.com/bpm/service?service.key=bpm.data
WS_URL=wss://your-instance.step2agility.com/worker
TOPICS=[{"topic":"demo-worker"}]
GROUP_ID=camunda
