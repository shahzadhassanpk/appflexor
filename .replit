modules = ["nodejs-24", "postgresql-16", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/appflexor: web"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "appflexor-connector: worker"

[[workflows.workflow]]
name = "artifacts/appflexor: web"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/appflexor run dev"
waitForPort = 18232

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "appflexor-connector: worker"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/appflexor-connector run start"

[workflows.workflow.metadata]
outputType = "console"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["github:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 18232
externalPort = 80

[[ports]]
localPort = 23863
externalPort = 3000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
AUTH_URL = "https://demo.step2agility.com/app/service?service.key=login"
BPM_URL = "https://demo.step2agility.com/bpm/service?service.key=complete.task"
GROUP_ID = "camunda"
TOPICS = "[{\"topic\":\"demo-worker\"}]"
WS_URL = "wss://demo.step2agility.com/worker"
